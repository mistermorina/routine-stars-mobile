# EAS Build upload ignore list.
#
# IMPORTANT: when this file exists, EAS uses it INSTEAD of .gitignore.
# It must therefore stay a SUPERSET of .gitignore — keep the first block in
# sync with .gitignore whenever that file changes.

# ---------------------------------------------------------------------------
# Mirror of .gitignore
# ---------------------------------------------------------------------------
node_modules/
.expo/
dist/
.DS_Store
*.jks
*.p8
*.p12
*.key
*.mobileprovision
*.orig.*
web-build/
ios/
android/
.env

# @generated expo-cli sync-2b81b286409207a5da26e14c78851eb30d8ccbdb
# The following patterns were generated by expo-cli

expo-env.d.ts
# @end expo-cli

# graphify (rebuild with: graphify update .)
graphify-out/

# ---------------------------------------------------------------------------
# EAS-only exclusions (git-tracked on purpose, must never reach a build)
# ---------------------------------------------------------------------------

# Design source + review renders: ~151 MB, referenced by no runtime code.
# assets/sticker-masters/ is only read by scripts/check-sticker-reward-logic.mjs,
# which never runs during a build.
assets/review/
assets/sticker-masters/

# Review artifacts and generated output
outputs/

# Documentation and agent tooling
docs/
.claude/

# Local dev / CI-only scripts. Verified safe to drop:
# package.json declares no preinstall/postinstall/eas-build-* hook, and no
# build-time config (babel, metro, tailwind, eslint, tsconfig, app.json, index.js)
# references scripts/. Re-include this directory if an eas-build-* lifecycle
# hook is ever added to package.json.
scripts/

# Root-level project docs (README stays if one is ever added)
/*.md
!/README.md
