{
  "expo": {
    "name": "Routine Stars",
    "slug": "routine-stars",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "routinestars",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#F8E9D7"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.routinestars.app"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#F8E9D7"
      },
      "package": "com.routinestars.app"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-asset",
      [
        "expo-image-picker",
        {
          "photosPermission": "Routine Stars benötigt Zugriff auf deine Fotomediathek, damit du ein eigenes Profilbild auswählen kannst."
        }
      ],
      "expo-audio",
      "expo-secure-store",
      "@react-native-community/datetimepicker"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
